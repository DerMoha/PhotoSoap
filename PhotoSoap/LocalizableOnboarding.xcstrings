{
  "sourceLanguage" : "en",
  "strings" : {
    "onboarding.card.anonymity.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzungsanalysen sind standardmäßig deaktiviert. Wenn du sie aktivierst, teilt PhotoSoap nur Nutzungs-Gesamtzahlen mit einer zufälligen App-Installationskennung; niemals Fotoinhalte oder Standortdaten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage analytics are off by default. If enabled, PhotoSoap shares only usage totals with a random app install identifier; never photo contents or location data."
          }
        }
      }
    },
    "onboarding.card.anonymity.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optionale Nutzungsanalysen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional usage analytics"
          }
        }
      }
    },
    "onboarding.card.privacy.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Wisch nach links legt ein Foto in deine Löschliste. Das Foto bleibt in deiner Mediathek, bis du das Löschen in iOS bestätigst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe left adds a photo to your Delete List. The photo stays in your library until you confirm deletion in iOS."
          }
        }
      }
    },
    "onboarding.card.privacy.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts wird sofort gelöscht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing is deleted right away"
          }
        }
      }
    },
    "onboarding.card.reward.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du Ausgewählte Fotos wählst, prüft PhotoSoap nur diese Auswahl. Du kannst später mehr hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you choose Selected Photos, PhotoSoap reviews only that selection. You can add more later."
          }
        }
      }
    },
    "onboarding.card.reward.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgewählte Fotos funktionieren auch"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selected Photos works too"
          }
        }
      }
    },
    "onboarding.cta" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weiter"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue"
          }
        }
      }
    },
    "onboarding.demo.delete" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löschliste"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete List"
          }
        }
      }
    },
    "onboarding.demo.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du prüfst immer nur ein Foto. Wische nach rechts, um es zu behalten. Wische nach links, um es in deine Löschliste zu legen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review one photo at a time. Swipe right to keep it. Swipe left to add it to your Delete List."
          }
        }
      }
    },
    "onboarding.demo.keep" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep"
          }
        }
      }
    },
