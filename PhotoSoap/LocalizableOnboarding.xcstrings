{
  "sourceLanguage" : "en",
  "strings" : {
    "onboarding.card.anonymity.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap führt anonyme Gesamtzahlen. Analysen sind aus und enthalten keine Fotos, IDs oder Standort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap keeps anonymous totals. Analytics are off and never include photos, IDs, or location."
          }
        }
      }
    },
    "onboarding.card.anonymity.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Community-Gesamtzahlen bleiben anonym"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Community totals stay anonymous"
          }
        }
      }
    },
    "onboarding.card.banner.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Banner unter dem Foto. Nicht auf Statistiken oder Erfolgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One banner below your photo. Not on Stats or Achievements."
          }
        }
      }
    },
    "onboarding.card.banner.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein nicht-personalisiertes Werbebanner"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One non-personalized ad banner"
          }
        }
      }
    },
    "onboarding.card.loyalty.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösche 2000 Fotos und das Überprüfungsbanner verschwindet dauerhaft kostenlos. Du kannst auch jederzeit werbefrei kaufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete 2000 photos and the review banner disappears permanently for free. You can also buy ad-free at any time."
          }
        }
      }
    },
    "onboarding.card.loyalty.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treue-Prämie bei 2000 Löschungen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loyalty unlock at 2000 deletes"
          }
        }
      }
    },
    "onboarding.card.privacy.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzungsanalysen sind standardmäßig aktiviert und helfen, PhotoSoap zu verbessern. Sie teilen anonyme Gesamtzahlen wie Installationen, überprüfte und gelöschte Fotos — niemals Fotoinhalte, Asset-IDs oder Standortdaten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage analytics are on by default and help improve PhotoSoap. They share anonymous totals like installs, photos reviewed, and deleted — never photo contents, asset IDs, or location."
          }
        }
      }
    },
    "onboarding.card.privacy.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Fotos bleiben bei dir"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your photos stay yours"
          }
        }
      }
    },
    "onboarding.card.reward.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösche 2000 Fotos und das Banner in der Review-Ansicht verschwindet dauerhaft kostenlos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete 2000 photos and the review banner disappears permanently for free."
          }
        }
      }
    },
    "onboarding.card.reward.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werbefrei schaltet sich frei"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ad-free unlocks itself"
          }
        }
      }
    },
