    },
    "onboarding.hero.subtitle" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische nach rechts, um ein Foto zu behalten, und nach links, um es zu löschen. Der Ablauf ist bewusst schnell und unkompliziert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe right to keep a photo and left to delete it. The flow is designed to feel fast and effortless."
          }
        }
      }
    },
    "onboarding.hero.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räume deine Mediathek mit einem Wisch auf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clean up your library with a swipe"
          }
        }
      }
    },
    "onboarding.subtitle" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap hält Monetarisierung einfach und datenschutzorientiert während du deine Bibliothek überprüfst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap keeps monetization simple and privacy-focused while you review your library."
          }
        }
      }
