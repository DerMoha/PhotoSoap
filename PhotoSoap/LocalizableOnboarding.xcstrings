          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein kurzer Hinweis, bevor du beginnst"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quick heads-up before you start"
          }
        }
      }
    },
    "onboarding.hero.eyebrow" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnellstart"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick start"
          }
        }
      }
    },
    "onboarding.hero.subtitle" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische nach rechts, um ein Foto zu behalten. Wische nach links, um es in deine Löschliste zu legen. Gelöscht wird erst, wenn du iOS bestätigst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe right to keep a photo. Swipe left to add it to your Delete List. Nothing is deleted until you confirm in iOS."
          }
        }
      }
    },
    "onboarding.hero.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räume deine Mediathek mit einem Wisch auf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clean up your library with a swipe"
          }
        }
      }
    },
    "onboarding.subtitle" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap hält Monetarisierung einfach und datenschutzorientiert während du deine Bibliothek überprüfst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap keeps monetization simple and privacy-focused while you review your library."
          }
        }
      }
    },
    "onboarding.welcome" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome"
          }
        }
      }
    },
    "permission.allow" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotozugriff wählen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Photo Access"
          }
        }
      }
    },
    "permission.denied.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap benötigt Fotobibliothek-Zugriff. Bitte aktiviere ihn in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap needs photo library access to work. Please enable it in Settings."
          }
        }
      }
    },
    "permission.denied.openSettings" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen öffnen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings"
          }
        }
      }
    },
    "permission.denied.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugriff verweigert"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access Denied"
          }
        }
      }
    },
    "permission.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap braucht Zugriff auf deine Fotobibliothek.\n\nAlle Fotos ist am einfachsten. Mit Ausgewählte Fotos prüfst du nur diese Auswahl und kannst später mehr hinzufügen.\n\nPhotoSoap startet mit Fotos. Videos kannst du später im Filter einschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap needs access to your photo library.\n\nAll Photos is the simplest option. If you choose Selected Photos, PhotoSoap reviews only that selection and you can add more later.\n\nPhotoSoap starts with photos. You can turn on videos later from filters."
          }
        }
      }
    },
    "permission.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotozugriff wählen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Photo Access"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
