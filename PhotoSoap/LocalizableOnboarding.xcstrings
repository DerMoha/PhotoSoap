            "value" : "Swipe right"
          }
        }
      }
    },
    "onboarding.demo.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Foto nach dem anderen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One photo at a time"
          }
        }
      }
    },
