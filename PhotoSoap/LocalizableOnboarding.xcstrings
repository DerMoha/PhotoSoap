    "onboarding.demo.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du prüfst immer nur ein Foto. Gehört es in deine Mediathek, behalte es. Wenn nicht, wische es weg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review one photo at a time. If it belongs in your library, keep it. If not, swipe it away."
          }
        }
      }
    },
    "onboarding.demo.keep" : {
      "localizations" : {
