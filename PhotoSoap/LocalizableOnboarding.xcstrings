{
  "sourceLanguage" : "en",
  "strings" : {
    "onboarding.card.anonymity.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap führt anonyme Gesamtzahlen. Analysen sind aus und enthalten keine Fotos, IDs oder Standort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap keeps anonymous totals. Analytics are off and never include photos, IDs, or location."
          }
        }
      }
    },
    "onboarding.card.anonymity.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Community-Gesamtzahlen bleiben anonym"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Community totals stay anonymous"
          }
        }
      }
    },
    "onboarding.card.banner.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Banner unter dem Foto. Nicht auf Statistiken oder Erfolgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One banner below your photo. Not on Stats or Achievements."
          }
        }
      }
    },
    "onboarding.card.banner.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein nicht-personalisiertes Werbebanner"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One non-personalized ad banner"
          }
        }
      }
    },
    "onboarding.card.loyalty.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösche 2000 Fotos und das Überprüfungsbanner verschwindet dauerhaft kostenlos. Du kannst auch jederzeit werbefrei kaufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete 2000 photos and the review banner disappears permanently for free. You can also buy ad-free at any time."
          }
        }
      }
    },
    "onboarding.card.loyalty.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treue-Prämie bei 2000 Löschungen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loyalty unlock at 2000 deletes"
          }
        }
      }
    },
    "onboarding.card.privacy.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Wisch nach links legt ein Foto in deine Löschliste. Das Foto bleibt in deiner Mediathek, bis du das Löschen in iOS bestätigst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe left adds a photo to your Delete List. The photo stays in your library until you confirm deletion in iOS."
          }
        }
      }
    },
    "onboarding.card.privacy.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts wird sofort gelöscht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing is deleted right away"
          }
        }
      }
    },
    "onboarding.card.reward.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du Ausgewählte Fotos wählst, zeigt PhotoSoap nur diese Fotos. Du kannst später mehr hinzufügen. Videos erscheinen nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you choose Selected Photos, PhotoSoap reviews only those photos. You can add more later. Videos will not appear."
          }
        }
      }
    },
    "onboarding.card.reward.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgewählte Fotos funktionieren auch"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selected Photos works too"
          }
        }
      }
    },
    "onboarding.cta" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weiter"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue"
          }
        }
      }
    },
