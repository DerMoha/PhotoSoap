{
  "sourceLanguage" : "en",
  "strings" : {
    "onboarding.analytics.changeLater" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jederzeit in den Einstellungen änderbar. PhotoSoap funktioniert mit beiden Optionen gleich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change this anytime in Settings. PhotoSoap works the same either way."
          }
        }
      }
    },
    "onboarding.analytics.choose" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Option aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose an option."
          }
        }
      }
    },
    "onboarding.analytics.decline" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht jetzt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not now"
          }
        }
      }
    },
    "onboarding.analytics.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile Gesamtzahlen darüber, was die Community überprüft, behält und aufräumt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share totals for what the community reviews, keeps, and cleans up."
          }
        }
      }
    },
    "onboarding.analytics.privacy" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Foto- oder Videoinhalte, Asset-IDs oder Standortdaten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No photo or video contents, asset IDs, or location data"
          }
        }
      }
    },
    "onboarding.analytics.identifier" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enthält eine zufällige App-Kennung, App-Version und Plattform."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Includes a random app identifier, app version, and platform."
          }
        }
      }
    },
    "onboarding.analytics.privacyPolicy" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datenschutzerklärung lesen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read the privacy policy"
          }
        }
      }
    },
    "onboarding.analytics.share" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Community-Gesamtzahlen teilen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share community totals"
          }
        }
      }
    },
    "onboarding.analytics.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baue die PhotoSoap-Community mit auf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build the PhotoSoap community"
          }
        }
      }
    },
    "onboarding.card.anonymity.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap fragt dich beim Einrichten, ob du Community-Nutzungszahlen teilen möchtest. Ohne deine Zustimmung werden keine Nutzungsanalysen gesammelt oder hochgeladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap asks during setup whether you want to share community usage totals. Without your consent, no usage analytics are collected or uploaded."
          }
        }
      }
    },
    "onboarding.card.anonymity.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optionale Nutzungsanalysen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional usage analytics"
          }
        }
      }
    },
    "onboarding.card.privacy.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Wisch nach links legt ein Foto in deine Löschliste. Das Foto bleibt in deiner Mediathek, bis du das Löschen in iOS bestätigst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe left adds a photo to your Delete List. The photo stays in your library until you confirm deletion in iOS."
          }
        }
      }
    },
    "onboarding.card.privacy.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts wird sofort gelöscht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing is deleted right away"
          }
        }
      }
    },
    "onboarding.card.reward.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du Ausgewählte Fotos wählst, prüft PhotoSoap nur diese Auswahl. Du kannst später mehr hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you choose Selected Photos, PhotoSoap reviews only that selection. You can add more later."
          }
        }
      }
    },
    "onboarding.card.reward.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgewählte Fotos funktionieren auch"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selected Photos works too"
          }
        }
      }
    },
    "onboarding.cta" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weiter"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue"
          }
        }
      }
    },
    "onboarding.demo.delete" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löschliste"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete List"
          }
        }
      }
    },
    "onboarding.demo.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du prüfst immer nur ein Foto. Wische nach rechts, um es zu behalten. Wische nach links, um es in deine Löschliste zu legen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review one photo at a time. Swipe right to keep it. Swipe left to add it to your Delete List."
          }
        }
      }
    },
    "onboarding.demo.keep" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep"
          }
        }
      }
    },
    "onboarding.demo.swipeLeft" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach links wischen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe left"
          }
        }
      }
    },
    "onboarding.demo.swipeRight" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach rechts wischen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe right"
          }
        }
      }
    },
    "onboarding.demo.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Foto nach dem anderen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One photo at a time"
          }
        }
      }
    },
    "onboarding.gotIt" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verstanden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Got it"
          }
        }
      }
    },
    "onboarding.headsUp" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein kurzer Hinweis, bevor du beginnst"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quick heads-up before you start"
          }
        }
      }
    },
    "onboarding.hero.eyebrow" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnellstart"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick start"
          }
        }
      }
    },
    "onboarding.hero.subtitle" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische nach rechts, um ein Foto zu behalten. Wische nach links, um es in deine Löschliste zu legen. Gelöscht wird erst, wenn du iOS bestätigst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe right to keep a photo. Swipe left to add it to your Delete List. Nothing is deleted until you confirm in iOS."
          }
        }
      }
    },
    "onboarding.hero.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räume deine Mediathek mit einem Wisch auf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clean up your library with a swipe"
          }
        }
      }
    },
    "onboarding.subtitle" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap hält Monetarisierung einfach und datenschutzorientiert während du deine Bibliothek überprüfst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap keeps monetization simple and privacy-focused while you review your library."
          }
        }
      }
    },
    "onboarding.welcome" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome"
          }
        }
      }
    },
    "permission.allow" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotozugriff wählen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Photo Access"
          }
        }
      }
    },
    "permission.denied.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap benötigt Fotobibliothek-Zugriff. Bitte aktiviere ihn in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap needs photo library access to work. Please enable it in Settings."
          }
        }
      }
    },
    "permission.denied.openSettings" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen öffnen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings"
          }
        }
      }
    },
    "permission.denied.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugriff verweigert"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access Denied"
          }
        }
      }
    },
    "permission.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap braucht Zugriff auf deine Fotobibliothek.\n\nAlle Fotos ist am einfachsten. Mit Ausgewählte Fotos prüfst du nur diese Auswahl und kannst später mehr hinzufügen.\n\nPhotoSoap startet mit Fotos. Videos kannst du später im Filter einschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap needs access to your photo library.\n\nAll Photos is the simplest option. If you choose Selected Photos, PhotoSoap reviews only that selection and you can add more later.\n\nPhotoSoap starts with photos. You can turn on videos later from filters."
          }
        }
      }
    },
    "permission.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotozugriff wählen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Photo Access"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
