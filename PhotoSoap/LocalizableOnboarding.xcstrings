          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome"
          }
        }
      }
    },
    "permission.allow" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotozugriff wählen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Photo Access"
          }
        }
      }
    },
    "permission.denied.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap benötigt Fotobibliothek-Zugriff. Bitte aktiviere ihn in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap needs photo library access to work. Please enable it in Settings."
          }
        }
      }
    },
    "permission.denied.openSettings" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen öffnen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings"
          }
        }
      }
    },
    "permission.denied.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugriff verweigert"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access Denied"
          }
        }
      }
    },
    "permission.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap braucht Zugriff auf deine Fotobibliothek.\n\nAlle Fotos ist am einfachsten. Mit Ausgewählte Fotos prüfst du nur diese Auswahl und kannst später mehr hinzufügen.\n\nPhotoSoap prüft nur Fotos. Ausgewählte Videos erscheinen nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap needs access to your photo library.\n\nAll Photos is the simplest option. If you choose Selected Photos, PhotoSoap reviews only that selection and you can add more later.\n\nPhotoSoap reviews photos only. Videos you select will not appear."
          }
        }
      }
    },
    "permission.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotozugriff wählen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Photo Access"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
