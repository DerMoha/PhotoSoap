          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein kurzer Hinweis, bevor du beginnst"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quick heads-up before you start"
          }
        }
      }
    },
    "onboarding.hero.eyebrow" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnellstart"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick start"
          }
        }
      }
    },
    "onboarding.hero.subtitle" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische nach rechts, um ein Foto zu behalten. Wische nach links, um es in deine Löschliste zu legen. Gelöscht wird erst, wenn du iOS bestätigst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe right to keep a photo. Swipe left to add it to your Delete List. Nothing is deleted until you confirm in iOS."
          }
        }
      }
    },
    "onboarding.hero.title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räume deine Mediathek mit einem Wisch auf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clean up your library with a swipe"
          }
        }
      }
    },
    "onboarding.subtitle" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap hält Monetarisierung einfach und datenschutzorientiert während du deine Bibliothek überprüfst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap keeps monetization simple and privacy-focused while you review your library."
          }
        }
      }
    },
    "onboarding.welcome" : {
      "extractionState" : "stale",
      "localizations" : {
