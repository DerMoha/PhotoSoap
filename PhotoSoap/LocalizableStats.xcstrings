    "settings.deletion.useQueueDescription" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, landen Fotos per Wisch nach links zuerst in der Löschliste. Wenn deaktiviert, werden sie nach einer Bestätigung sofort gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, swipe left queues photos for batch deletion. When off, swipe left deletes immediately with one confirmation."
          }
        }
      }
    },
