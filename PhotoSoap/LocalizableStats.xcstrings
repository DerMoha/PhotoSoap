    "stats.privacy.analyticsDescription" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzungsanalysen helfen, PhotoSoap zu verbessern, und sind standardmäßig deaktiviert. Wenn du sie aktivierst, teilt PhotoSoap Nutzungs-Gesamtzahlen wie Installationen, überprüfte und gelöschte Fotos mit einer zufälligen App-Installationskennung; niemals Fotoinhalte, Asset-IDs oder Standortdaten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage analytics help improve PhotoSoap and are off by default. If you turn them on, PhotoSoap shares usage totals like installs, photos reviewed, and photos deleted with a random app install identifier; never photo contents, asset IDs, or location data."
          }
        }
      }
    },
    "stats.privacy.communityTotals" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn diese Option deaktiviert ist, sammelt oder lädt PhotoSoap keine Nutzungsanalysen hoch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When this is off, PhotoSoap does not collect or upload usage analytics."
          }
        }
      }
    },
