    "settings.deletion.useQueue" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löschliste verwenden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Delete List"
          }
        }
      }
    },
    "settings.deletion.useQueueDescription" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, legt ein Wisch nach links Fotos in die Löschliste, damit du sie später zusammen löschen kannst. Wenn deaktiviert, fragt iOS bei jedem Foto sofort nach dem Löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, swipe left adds photos to your Delete List so you can delete them together later. When off, iOS asks to delete each photo right away."
          }
        }
      }
    },
