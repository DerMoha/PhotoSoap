    "stats.privacy.analyticsDescription" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzungsanalysen helfen, PhotoSoap zu verbessern, und sind standardmäßig aktiviert. Sie teilen anonyme Gesamtzahlen wie Installationen, überprüfte und gelöschte Fotos — niemals Fotoinhalte, Asset-IDs oder Standortdaten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage analytics help improve PhotoSoap and are on by default. They share anonymous totals like installs, photos reviewed, and deleted — never photo contents, asset IDs, or location data."
          }
        }
      }
    },
    "stats.privacy.communityTotals" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap führt immer anonyme Gesamtzahlen für Installationen, überprüfte und gelöschte Fotos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhotoSoap always keeps anonymous totals for installs, photos reviewed, and deleted."
          }
        }
      }
    },
