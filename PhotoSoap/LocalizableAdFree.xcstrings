    "adfree.banner.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Banner nur beim Überprüfen. Nicht auf Statistiken oder Erfolgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One banner only while reviewing. Not on Stats or Achievements."
          }
        }
